# Set these as environment variables locally, or as App Service application settings on Azure.

# Azure OpenAI resource (v1 API, no api-version needed). Leave the key blank for demo mode.
ENDPOINT_URL=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=

# Deployment names as created in the Azure OpenAI portal.
# Luna reads video frames, Terra reads photos, Sol re-checks low-confidence drafts (blank = off).
DEPLOYMENT_LUNA=gpt-5.6-luna
DEPLOYMENT_TERRA=gpt-5.6-terra
DEPLOYMENT_SOL=gpt-5.6-sol
ESCALATE_BELOW=0.6
# Which tier reads photos and video frames: luna | terra | sol
PHOTO_TIER=terra
VIDEO_TIER=luna

# Reasoning effort per tier: none | low | medium | high | xhigh | max
# LUNA_EFFORT=low
# TERRA_EFFORT=low
# SOL_EFFORT=medium

FLASK_SECRET_KEY=change-me

# Database. On Azure App Service (Linux) /home persists across restarts and deploys.
TOOLS_DB_PATH=instance/tools.db

# Photos and backups. With AZURE_STORAGE_ACCOUNT set they go to Blob Storage (the app signs in with
# its managed identity); without it they go to these local folders.
# AZURE_STORAGE_ACCOUNT=nradls
# MEDIA_CONTAINER=toolshare-media
# BACKUP_CONTAINER=toolshare-backups
UPLOAD_FOLDER=instance/uploads
BACKUP_FOLDER=instance/backups

# Admin dashboard at /admin (disabled when blank)
ADMIN_PASSWORD=
# Photos + video frames each member can analyze per 24 hours
UPLOAD_DAILY_LIMIT=150
# Show the seeded sample listings (1) or only real members' listings (0)
SHOW_DEMO_LISTINGS=1

# Center of the demo neighborhood (defaults to Denver)
# DEMO_CENTER_LAT=39.7392
# DEMO_CENTER_LNG=-104.9903

# Sign in with Google / Microsoft (buttons appear only when both values are set; deploy/setup-sign-in.sh sets them)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Azure Maps: ZIP code -> city/state. On Azure the managed identity signs in (deploy script sets the client id);
# locally a key works. Without either, ZIPs are accepted but not checked, and locations fall back to the demo center.
# AZURE_MAPS_CLIENT_ID=
# AZURE_MAPS_KEY=

# Uber Direct courier delivery (deploy/setup-delivery.sh sets these). See docs/delivery.md.
# UBER_DIRECT_CUSTOMER_ID=
# UBER_DIRECT_CLIENT_ID=
# UBER_DIRECT_CLIENT_SECRET=
# UBER_DIRECT_WEBHOOK_KEY=
# COURIER_LIVE=0              # 1 = real, billed couriers; otherwise Uber's test "Robocourier"
# DELIVERY_MARKUP_PCT=15
# DELIVERY_MARKUP_FLAT=1.00
